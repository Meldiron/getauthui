{
  "name": "@getauthui/core",
  "version": "0.1.7",
  "description": "Drop-in authentication UI for Appwrite. One script tag, every sign-in method, MFA, sessions and account management as web components.",
  "type": "module",
  "main": "./dist/authui.js",
  "module": "./dist/authui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/authui.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./cdn": "./dist/authui.cdn.mjs",
    "./cdn/iife": "./dist/authui.cdn.js"
  },
  "unpkg": "./dist/authui.cdn.mjs",
  "jsdelivr": "./dist/authui.cdn.mjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "sideEffects": true,
  "keywords": [
    "appwrite",
    "auth",
    "authentication",
    "login",
    "web-components",
    "lit",
    "mfa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Meldiron/getauthui"
  },
  "peerDependencies": {
    "appwrite": ">=20.0.0",
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "appwrite": "^27.0.0",
    "jsdom": "^26.1.0",
    "lit": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.cdn.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE && npm run build"
  }
}
